<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="600.0" maxWidth="900.0" minHeight="600.0" minWidth="900.0" prefHeight="600" prefWidth="900" styleClass="space-root" stylesheets="@space-theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Notification Icon (Top Right) -->
    <Button fx:id="notificationBtn" layoutX="830" layoutY="20" prefHeight="50" prefWidth="50" style="-fx-font-size: 20px;" styleClass="notification-btn" text="🔔" />

    <!-- Notification Popup (Hidden by default) -->
    <VBox fx:id="notificationPanel" layoutX="650" layoutY="80" maxHeight="900" prefWidth="600" spacing="8" styleClass="login-card" visible="false">
        <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
        </padding>
        <children>
            <Label style="-fx-font-size: 18px;" styleClass="login-title" text="Notifications" />
            <Separator style="-fx-background-color: rgba(255,255,255,0.3);" />
            <ScrollPane fitToWidth="true" prefHeight="200" styleClass="scroll-pane">
                <VBox fx:id="notificationList" spacing="10">
                    <!-- Example Notification -->
                    <VBox spacing="5" styleClass="notification-item">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8" />
                        </padding>
                        <Label style="-fx-text-fill: #AAAAFF; -fx-font-size: 10px;" text="2 hours ago" />
                        <Label style="-fx-text-fill: #E0E0FF; -fx-font-size: 12px;" text="New request from student" wrapText="true" />
                    </VBox>

                    <VBox spacing="5" styleClass="notification-item">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8" />
                        </padding>
                        <Label style="-fx-text-fill: #AAAAFF; -fx-font-size: 10px;" text="5 hours ago" />
                        <Label style="-fx-text-fill: #E0E0FF; -fx-font-size: 12px;" text="Your offer was accepted" wrapText="true" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </children>
    </VBox>

    <!-- Main Content (Center) -->
    <VBox alignment="TOP_CENTER" layoutX="250" layoutY="80" prefWidth="400" spacing="25">
        <children>
            <!-- Title -->
            <Label style="-fx-font-size: 42px;" styleClass="login-title" text="Parho-Parhao" />

            <!-- Welcome Message -->
            <Label fx:id="welcomeLabel" style="-fx-font-size: 24px;" styleClass="login-title" text="Welcome Teacher Name!" />

            <!-- Main Action Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <children>
                    <Button fx:id="requestsBtn" prefHeight="80" prefWidth="180" style="-fx-font-size: 20px;" styleClass="login-btn" text="Requests" />

                    <Button fx:id="myOffersBtn" prefHeight="80" prefWidth="180" style="-fx-font-size: 20px;" styleClass="login-btn" text="My Offers" />
                </children>
            </HBox>

            <!-- Open Chat Button -->
            <Button fx:id="openChatBtn" prefHeight="50" prefWidth="250" style="-fx-font-size: 16px;" styleClass="role-btn" text="Open Chat" />

            <!-- View Profile Link -->
            <Hyperlink fx:id="viewProfileLink" style="-fx-font-size: 14px;" styleClass="signup-link" text="View your profile" />
        </children>
    </VBox>

    <!-- Logout Button (Bottom Left) -->
    <Button fx:id="logoutBtn" layoutX="20" layoutY="530" prefHeight="40" prefWidth="100" style="-fx-font-size: 14px;" styleClass="role-btn" text="Logout" />

</AnchorPane>
