<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1280" styleClass="space-root" stylesheets="@../../../space-theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.HomeController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="240" spacing="0" styleClass="sidebar-panel">
            <padding><Insets bottom="20" left="0" right="0" top="0" /></padding>
            <VBox alignment="CENTER" spacing="5" styleClass="logo-section">
                <padding><Insets bottom="30" left="20" right="20" top="30" /></padding>
                <Label style="-fx-font-size: 36px;" text="🎓" />
                <Label styleClass="logo-text" text="Parha Do" />
                <Label styleClass="logo-subtitle" text="Learning Platform" />
            </VBox>
            <HBox styleClass="sidebar-divider"><padding><Insets left="20" right="20" /></padding></HBox>
            <VBox spacing="8" styleClass="nav-menu">
                <padding><Insets bottom="25" left="15" right="15" top="25" /></padding>
                <Label styleClass="menu-label" text="MAIN MENU" />
                <Button fx:id="btnHome" onAction="#onHomeClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn" text="   🏠  Student Home" />
                <Button fx:id="btnProfile" onAction="#onProfileClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn" text="   👤  My Profile" />
                <Button fx:id="btnPostRequest" onAction="#onPostRequestClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn, active" text="   📝  Post New Request" />
                <Button fx:id="btnViewTutors" onAction="#onViewTutorsClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn" text="   👨‍🏫  View Tutors" />
                <Button fx:id="btnMyBookings" onAction="#onMyBookingsClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn" text="   📅  My Bookings" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="8">
                <padding><Insets bottom="25" left="15" right="15" top="15" /></padding>
                <HBox styleClass="sidebar-divider" />
                <Region prefHeight="10" />
                <Button fx:id="btnSettings" onAction="#onSettingsClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn" text="   ⚙️  Settings" />
                <Button fx:id="btnLogout" onAction="#onLogoutClick" alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="sidebar-btn, logout-btn" text="   🚪  Logout" />
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="0" styleClass="main-content">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">
                <padding><Insets bottom="20" left="30" right="30" top="20" /></padding>
                <VBox spacing="3">
                    <Label styleClass="welcome-text" text="Post New Request" />
                    <Label styleClass="welcome-subtitle" text="Find the perfect tutor for your needs" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="icon-btn" text="🔔" />
                <VBox alignment="CENTER" styleClass="profile-avatar">
                    <Label styleClass="avatar-text" text="H" />
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="content-scroll">
                <VBox spacing="25">
                    <padding><Insets bottom="30" left="30" right="30" top="25" /></padding>

                    <VBox spacing="20" styleClass="stat-card" style="-fx-padding: 30;">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="📝 Create Tutoring Request" />
                        <Separator />

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Subject / Topic *" />
                            <TextField fx:id="txtSubject" promptText="e.g., Data Structures, Calculus, Physics" style="-fx-pref-height: 40;" />
                        </VBox>

                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Category *" />
                                <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Select Category" />
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Difficulty Level *" />
                                <ComboBox fx:id="cmbDifficulty" maxWidth="Infinity" promptText="Select Level" />
                            </VBox>
                        </HBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Description *" />
                            <TextArea fx:id="txtDescription" prefRowCount="4" promptText="Describe what you need help with..." wrapText="true" />
                        </VBox>

                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Budget (per hour) *" />
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Rs." style="-fx-font-size: 14px;" />
                                    <TextField fx:id="txtBudgetMin" prefWidth="80" promptText="Min" />
                                    <Label text=" - " />
                                    <TextField fx:id="txtBudgetMax" prefWidth="80" promptText="Max" />
                                    <Label text="/hr" style="-fx-text-fill: #888;" />
                                </HBox>
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Session Duration *" />
                                <ComboBox fx:id="cmbDuration" maxWidth="Infinity" promptText="Select Duration" />
                            </VBox>
                        </HBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Preferred Schedule" />
                            <HBox spacing="15">
                                <CheckBox fx:id="chkMonday" text="Mon" />
                                <CheckBox fx:id="chkTuesday" text="Tue" />
                                <CheckBox fx:id="chkWednesday" text="Wed" />
                                <CheckBox fx:id="chkThursday" text="Thu" />
                                <CheckBox fx:id="chkFriday" text="Fri" />
                                <CheckBox fx:id="chkSaturday" text="Sat" />
                                <CheckBox fx:id="chkSunday" text="Sun" />
                            </HBox>
                        </VBox>

                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Preferred Time" />
                                <ComboBox fx:id="cmbTimePreference" maxWidth="Infinity" promptText="Select Time" />
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Session Type" />
                                <ComboBox fx:id="cmbSessionType" maxWidth="Infinity" promptText="Select Type" />
                            </VBox>
                        </HBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Request Active For" />
                            <ComboBox fx:id="cmbRequestDuration" maxWidth="300" promptText="How long should this request be active?" />
                        </VBox>

                        <Separator />

                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button text="Save as Draft" style="-fx-pref-width: 120;" />
                            <Button text="Preview" style="-fx-pref-width: 100;" />
                            <Button fx:id="btnSubmitRequest" onAction="#onSubmitRequestClick" styleClass="accept-btn" text="📤 Post Request" style="-fx-pref-width: 150; -fx-pref-height: 40; -fx-font-size: 14px;" />
                        </HBox>
                    </VBox>

                    <VBox spacing="15" styleClass="offer-card">
                        <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="💡 Tips for a Great Request" />
                        <Separator />
                        <VBox spacing="10">
                            <Label text="✓ Be specific about what topics or concepts you need help with" wrapText="true" />
                            <Label text="✓ Mention your current level of understanding" wrapText="true" />
                            <Label text="✓ Set a realistic budget based on market rates" wrapText="true" />
                            <Label text="✓ Be flexible with your schedule to get more offers" wrapText="true" />
                            <Label text="✓ Respond to offers promptly - tutors appreciate quick replies!" wrapText="true" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <!-- RIGHT PANEL -->
    <right>
        <VBox prefWidth="300" spacing="0" styleClass="chat-panel">
            <VBox spacing="12" style="-fx-background-color: rgba(100, 200, 255, 0.1); -fx-padding: 20;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="📊 Your Request Stats" />
                <HBox spacing="15">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #64C8FF;" text="3" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Active" />
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="12" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Fulfilled" />
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="5" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Pending" />
                    </VBox>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" styleClass="chat-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="15">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Recent Requests" />

                    <VBox spacing="8" style="-fx-background-color: rgba(255, 152, 0, 0.1); -fx-padding: 12; -fx-background-radius: 8;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Operating Systems" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="5 offers • 2 days ago" />
                        <Label style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 8; -fx-font-size: 9px;" text="ACTIVE" />
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: rgba(100, 200, 255, 0.1); -fx-padding: 12; -fx-background-radius: 8;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Machine Learning" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="2 offers • 4 days ago" />
                        <Label style="-fx-background-color: #64C8FF; -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 8; -fx-font-size: 9px;" text="ACTIVE" />
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: rgba(76, 175, 80, 0.1); -fx-padding: 12; -fx-background-radius: 8;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Data Structures" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Completed • 1 week ago" />
                        <Label style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 8; -fx-font-size: 9px;" text="FULFILLED" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </right>
</BorderPane>