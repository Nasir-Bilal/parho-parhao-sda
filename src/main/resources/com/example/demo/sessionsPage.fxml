<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<AnchorPane prefHeight="600" prefWidth="900" styleClass="space-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.HelloController">

    <!-- ========== SIDEBAR ========== -->
    <VBox fx:id="sidebar" prefHeight="600.0" prefWidth="200" spacing="8" style="-fx-background-color: rgba(255,255,255,0.08); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 2, 0);">
        <padding>
            <Insets bottom="30" left="15" right="15" top="30" />
        </padding>

        <!-- App Title/Logo -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 20 5;" text="Parho Parhao" />

        <!-- Navigation Buttons -->
        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn" text="📊  Dashboard">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn" text="📝  Requests">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn" text="💼  My Offers">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn, sidebar-btn-active" text="📅  Sessions">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn" text="💬  Chat">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn" text="👤  View Profile">
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </Button>

        <!-- Spacer to push logout to bottom -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Logout Button -->
        <Button prefHeight="45" prefWidth="170" styleClass="sidebar-btn-logout" text="🚪  Logout" />
    </VBox>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <ScrollPane fitToWidth="true" layoutX="210" layoutY="0" prefHeight="600" prefWidth="690" style="-fx-background: transparent; -fx-background-color: transparent;" styleClass="scroll-pane">
        <VBox fillWidth="true" spacing="25">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <!-- Page Title -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="My Sessions" />

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Filter Dropdown -->
                <ComboBox fx:id="sessionFilterComboBox" prefWidth="180" promptText="Filter Sessions" styleClass="input-field" />
            </HBox>

            <!-- Sessions Grid Container - Cards will be added dynamically in 2 columns -->
            <GridPane fx:id="sessionsGridPane" hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
            </GridPane>

        </VBox>
    </ScrollPane>

</AnchorPane>