<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900" prefHeight="600"
            stylesheets="@../../../space-theme.css"
            styleClass="space-root"
            fx:controller="com.example.demo.HomeController">

    <children>
        <VBox alignment="CENTER" spacing="15"
              prefWidth="400"
              layoutX="250" layoutY="100"
              styleClass="login-card">

            <children>
                <Label text="Create Account"
                       styleClass="login-title" />

                <HBox spacing="10" alignment="CENTER">
                    <children>
                        <Button fx:id="studentBtn" text="Student"
                                prefWidth="100"
                                styleClass="role-btn" />
                        <Button fx:id="tutorBtn" text="Tutor"
                                prefWidth="100"
                                styleClass="role-btn" />
                    </children>
                </HBox>

                <!-- Updated fields -->
                <TextField fx:id="txtSignupName"
                           promptText="Full Name"
                           prefWidth="250"
                           styleClass="input-field" />

                <TextField fx:id="txtSignupEmail"
                           promptText="Email"
                           prefWidth="250"
                           styleClass="input-field" />

                <PasswordField fx:id="txtSignupPassword"
                               promptText="Password"
                               prefWidth="250"
                               styleClass="input-field" />

                <PasswordField fx:id="txtSignupConfirmPassword"
                               promptText="Confirm Password"
                               prefWidth="250"
                               styleClass="input-field" />

                <Button fx:id="btnSignup"
                        text="Sign Up"
                        onAction="#onSignupButtonClick"
                        prefWidth="120"
                        styleClass="login-btn" />

                <Hyperlink fx:id="linkBackToLogin"
                           text="Already have an account? Login"
                           onAction="#onBackToLoginClick"
                           styleClass="signup-link" />
            </children>

            <padding>
                <Insets top="25" bottom="25" left="25" right="25"/>
            </padding>

        </VBox>
    </children>

</AnchorPane>
